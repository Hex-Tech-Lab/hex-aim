{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/school/asten-college", "destination": "/school/asten-college.html" },
    { "source": "/school/:path*", "destination": "/school/asten-college.html" },
    { "source": "/exam/exam_y4_sci_term1", "destination": "/exam/exam_y4_sci_term1.html" },
    { "source": "/exam/exam_y4_math_term1", "destination": "/exam/exam_y4_math_term1.html" },
    { "source": "/exam/:path*", "destination": "/exam/exam_y4_sci_term1.html" },
    { "source": "/sprint/preview", "destination": "/sprint/preview.html" },
    { "source": "/guide/preview", "destination": "/guide/preview.html" },
    { "source": "/sprint/:path*", "destination": "/sprint/preview.html" },
    { "source": "/guide/:path*", "destination": "/guide/preview.html" }
  ],
  "headers": [
    {
      "source": "/api/template/(.*)/pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/api/sprint/(.*)/pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ]
}
